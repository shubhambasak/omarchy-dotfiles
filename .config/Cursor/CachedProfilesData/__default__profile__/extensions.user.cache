a3294c789678","icon":"resources/icon.png","repository":{"type":"git","url":"https://github.com/getcursor/cursor.git"},"publisher":"anysphere","aiKey":"98e159a9-4c4f-4dc7-9350-e420cfe9078a","engines":{"vscode":"^1.75.0"},"extensionKind":["ui"],"enabledApiProposals":["resolvers","tunnels","contribViewsRemote","cursorTracing"],"keywords":["remote development","remote","container"],"capabilities":{"untrustedWorkspaces":{"supported":true},"virtualWorkspaces":true},"api":"none","activationEvents":["workspaceContains:.devcontainer/devcontainer.json","workspaceContains:.devcontainer/**/devcontainer.json","workspaceContains:.devcontainer.json","onResolveRemoteAuthority:dev-container","onResolveRemoteAuthority:attached-container","onResolveRemoteAuthority:k8s-container","onDebugResolve:extensionHost"],"main":"./dist/main.js","contributes":{"configuration":{"title":"Dev Containers","properties":{"dev.containers.dockerPath":{"scope":"application","type":"string","description":"Path to container engine executable (for example: docker or podman)","default":"docker"},"dev.containers.remoteDockerPath":{"scope":"application","type":"object","default":{},"description":"A map of remote host/authority to container engine executable path (for example: podman). Use '*' as the fallback for all remotes. If a host is not configured here, dev.containers.dockerPath is used.","additionalProperties":{"type":"string"}},"dev.containers.kubectlPath":{"scope":"application","type":"string","description":"Path to kubectl executable","default":"kubectl"},"dev.containers.enableSSHAgentForwarding":{"type":"boolean","title":"Enable SSH Agent Forwarding","default":true,"description":"Enable SSH agent forwarding when connecting to devcontainers."},"dev.containers.enableGPGAgentForwarding":{"type":"boolean","title":"Enable GPG Agent Forwarding","default":true,"description":"Enable GPG agent forwarding when connecting to devcontainers for commit signing."},"dev.containers.copyGitConfig":{"type":"boolean","title":"Copy Git Config","default":true,"description":"Copy the .gitconfig file to the devcontainer."},"dev.containers.gpuAvailability":{"type":"string","title":"GPU Availability","default":"detect","description":"The availability of GPU resources in the devcontainer.","enum":["detect","all","none"],"enumDescriptions":["Detect GPU availability","All GPUs are available. The host must have GPUs.","No GPUs are available."]},"dev.containers.showReopenInContainerPrompt":{"type":"boolean","title":"Show 'Reopen in Container' Prompt","default":true,"description":"Controls whether a notification is shown when a devcontainer.json is detected. Set to false to suppress the prompt. Configurable at user or workspace scope.","scope":"window"},"dev.containers.workspaceMountConsistency":{"type":"string","title":"Workspace Mount Consistency","default":"cached","description":"The consistency level for the workspace mount. Existing containers need to be rebuilt for this setting to take effect.","enum":["consistent","cached","delegated"],"enumDescriptions":["Consistent: Perfect consistency between the host and the devcontainer.","Cached: The host is authoritative.","Delegated: The devcontainer is authoritative."]},"dev.containers.defaultFeatures":{"type":"object","description":"Additional features to apply to the dev container","default":{}},"dev.containers.defaultExtensions":{"type":"array","items":{"type":"string"},"default":[],"description":"List of extensions that should be installed automatically on all devcontainers.","scope":"application"},"dotfiles.repository":{"type":"string","default":"","description":"URL of a Git repository containing your dotfiles, or the repository's owner/name for a GitHub repository.","scope":"application"},"dotfiles.targetPath":{"type":"string","default":"~/dotfiles","description":"Target path to clone the dotfiles repository to. Defaults to ~/dotfiles.","scope":"application"},"dotfiles.installCommand":{"type":"string","default":"","description":"The command to run after cloning the dotfiles repository. Defaults to the first file found of: install.sh, install, bootstrap.sh, bootstrap, setup.sh, setup.","scope":"application"}}},"resourceLabelFormatters":[{"scheme":"vscode-remote","authority":"dev-container+*","formatting":{"label":"${path}","separator":"/","tildify":true,"workspaceSuffix":"Dev Container"}},{"scheme":"vscode-remote","authority":"attached-container+*","formatting":{"label":"${path}","separator":"/","tildify":true,"workspaceSuffix":"Attached Container"}},{"scheme":"vscode-remote","authority":"k8s-container+*","formatting":{"label":"${path}","separator":"/","tildify":true,"workspaceSuffix":"K8S Container"}}],"views":{"remote":[{"id":"targetsContainers","name":"Dev Containers","group":"targets@1","remoteName":["dev-container","attached-container","exec"]}]},"commands":[{"command":"remote-containers.openFolder","title":"Open Folder in Container","category":"Dev Containers","icon":"$(folder-opened)"},{"command":"remote-containers.attachToContainerInCurrentWindow","title":"Attach in Current Window","category":"Dev Containers","icon":"$(arrow-right)"},{"command":"remote-containers.attachToContainerInNewWindow","title":"Attach in New Window","category":"Dev Containers","icon":"$(empty-window)"},{"command":"remote-containers.explorerDetailsRefresh","title":"Refresh","category":"Dev Containers","icon":"$(refresh)"},{"command":"remote-containers.showLog","title":"Show Dev Containers Log","category":"Dev Containers","icon":"$(file-text)"},{"command":"remote-containers.reopenFolderLocally","title":"Reopen Folder Locally","category":"Dev Containers","when":"remoteName","icon":"$(folder-opened)"},{"command":"remote-containers.attachToRunningContainer","title":"Attach to Running Container","category":"Dev Containers"},{"command":"remote-containers.openDevContainerFile","title":"Open Container Configuration File","category":"Dev Containers","icon":"$(gear)"},{"command":"remote-containers.removeContainer","title":"Remove Container","category":"Dev Containers","icon":"$(remove)"},{"command":"remote-containers.startContainer","title":"Start Container","category":"Dev Containers","icon":"$(vm-start)"},{"command":"remote-containers.showContainerLog","title":"Show Container Log","category":"Dev Containers","icon":"$(file-text)"},{"command":"remote-containers.showDetails","title":"Show Details","category":"Dev Containers","icon":"$(inspect)"},{"command":"remote-containers.stopContainer","title":"Stop Container","category":"Dev Containers","icon":"$(debug-stop)"},{"command":"remote-containers.killServerAndReload","title":"Kill Remote Server and Reload Window","category":"Dev Containers","icon":"$(reload)"},{"command":"remote-containers.reinstallServerAndReload","title":"Reinstall Remote Server and Reload Window","category":"Dev Containers","icon":"$(trash)"},{"command":"remote-containers.attachToK8sContainer","title":"Attach to Running Kubernetes Container...","category":"Dev Containers"},{"command":"remote-containers.attachToRunningContainerFromViewlet","title":"Attach Cursor...","category":"Dev Containers"},{"command":"remote-containers.attachToK8sContainerFromViewlet","title":"Attach Cursor...","category":"Dev Containers"},{"command":"remote-containers.triggerReconnect","title":"Trigger Reconnect","category":"Dev Containers","icon":"$(refresh)"},{"command":"remote-containers.reopenInContainer","title":"Reopen in Container","category":"Dev Containers","icon":"$(folder-opened)"},{"command":"remote-containers.switchContainer","title":"Switch Container","category":"Dev Containers","icon":"$(arrow-swap)"},{"command":"remote-containers.rebuildAndReopenInContainer","title":"Rebuild and Reopen in Container","category":"Dev Containers"},{"command":"remote-containers.rebuildNoCacheAndReopenInContainer","title":"Rebuild Without Cache and Reopen in Container","category":"Dev Containers"},{"command":"remote-containers.rebuildContainer","title":"Rebuild Container","category":"Dev Containers"},{"com